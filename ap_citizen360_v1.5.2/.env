# ── LLM & Embedding Backend Configuration ────────────────────────────────────
# LLM Backend for Chat/SQL Reasoning: "vllm" (port 8000) or "ollama"
LLM_BACKEND=vllm

# Embedding Provider for Vector RAG (Milvus/Chunks): "ollama" (port 11434) or "vllm"
EMBEDDING_PROVIDER=ollama

# ── vLLM Chat Server Configuration (Qwen model on port 8000) ─────────────────
# Note: Total context window (16384) is set on the vLLM server via: --max-model-len 16384
# VLLM_MAX_TOKENS controls max generated response tokens (corresponds to Ollama's num_predict)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_CHAT_MODEL=qwen
VLLM_API_KEY=EMPTY
VLLM_NUM_CTX=16384
VLLM_MAX_TOKENS=1024
VLLM_TEMPERATURE=0.0
VLLM_REASONING=false
# VLLM_REASONING: set to false to disable chain-of-thought/thinking tags (faster, direct SQL/text)
#                 set to true if using reasoning models (like deepseek-r1/qwq) and you want thinking on

# vLLM Sub-model Configurations (Input context window & Output generation caps)
VLLM_SUMMARIZE_MODEL=qwen
VLLM_SUMMARIZE_NUM_CTX=2048
VLLM_SUMMARIZE_MAX_TOKENS=256

VLLM_DOC_NUM_CTX=4096
VLLM_DOC_MAX_TOKENS=512

VLLM_INTENT_NUM_CTX=2048
VLLM_INTENT_MAX_TOKENS=64

# ── Ollama Server Configuration (Embeddings on port 11434 & fallback chat) ───
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen3.5:0.8b-mlx    
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=1024
OLLAMA_REASONING=false
# OLLAMA_REASONING: set to true to enable chain-of-thought thinking (recommended for reasoning models like deepseek-r1)
#                   set to false to disable (faster, lower memory, default for non-reasoning models)
OLLAMA_SUMMARIZE_NUM_CTX=2048
OLLAMA_SUMMARIZE_NUM_PREDICT=128
OLLAMA_SUMMARIZE_MODEL=qwen3.5:0.8b-mlx
OLLAMA_INTENT_NUM_CTX=2048
OLLAMA_INTENT_NUM_PREDICT=256
OLLAMA_DOC_NUM_CTX=4096
OLLAMA_DOC_NUM_PREDICT=256
RAG_TOP_K=6
MAX_VERIFY_LOOPS=3
MAX_LLM_CALLS=25
MAX_RAG_CALLS=5
SCHEMA_MIN_SCORE=0.20

# ── MCP Server paths (override defaults in tools.py if needed) ────────────────
# RAG_SERVER_PATH=./servers/retrieval_mcp_server.py
# TOOL_SERVER_PATH=./servers/tool_mcp_server.py

# Impala MCP (disabled by default; enable on CDP server with kinit credentials)
# HIVE_MCP_ENABLED name preserved for backward compatibility — controls Impala executor
HIVE_MCP_ENABLED=false
HIVE_HOST=dl-dev-cl-fn01.datalake-dev.local
HIVE_PORT=21050
HIVE_DATABASE=ap_citizen360

# ── Impala / Kerberos Runtime Environment (required on CDP server) ────────────
# Set these before starting the app on the server (kinit must also be run).
# The values below match the verified CDP cluster configuration.
JAVA_HOME=/usr/lib/jvm/java-1.8.0-openjdk-1.8.0.492.b09-2.el9.x86_64/jre
HADOOP_HOME=/usr/local/hadoop-3.3.6
HADOOP_CONF_DIR=${HOME}/hadoop-configuration
# CLASSPATH is set automatically by hive_startup_check.py via: hadoop classpath --glob
MODEL_DIR=/Users/prakhar/Downloads/english-speech-to-text/english-speech-to-text/models/faster-whisper
ENABLE_SPEECH_TO_TEXT=false

# ── Live Logs Authentication (TOTP / Google Authenticator) ───────────────────
LOGS_AUTH_SECRET=JBSWY3DPEHPK3PXP